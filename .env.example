# CrossBorder AI Workspace — 环境变量模板
# 用法：复制为 .env.local 后填写。.env.local 已被 .gitignore 排除，禁止提交。
# 安全约束：任何真实密钥只允许存在于 .env.local，不得写进源码或文档。

# ── 数据库（本地 PostgreSQL，第一阶段不使用 Docker / 不产生费用）──
# 格式 postgresql://<用户>:<密码>@<主机>:<端口>/<库名>
DATABASE_URL=postgresql://cbai:change_me@127.0.0.1:5432/crossborder_ai

# ── 本地单用户标识（Sprint 1 占位；认证在后续 Sprint 接入）──
APP_USER_ID=00000000-0000-0000-0000-000000000001

# ── AI Provider ──────────────────────────────────────────────
# none              = 未配置：系统明确提示「AI 未启用」，不调用任何模型、不产生费用（第一阶段默认）
# mock              = 本地模拟：所有输出强制标注「模拟」，绝不冒充真实 AI
# openai-compatible = 需你书面批准后自行配置；未经批准不得启用，不得擅自选择付费 API
AI_PROVIDER=none
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=

# ── 运行环境 ────────────────────────────────────────────────
APP_ENV=local
